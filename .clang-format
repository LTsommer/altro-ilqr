# Code style for altro_fix/. Apply it with scripts/format.sh.
BasedOnStyle: Google
IndentWidth: 4
ContinuationIndentWidth: 8
AccessModifierOffset: -4
ColumnLimit: 120
DerivePointerAlignment: false
PointerAlignment: Right
AllowShortFunctionsOnASingleLine: Inline
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
# One enumerator per line.
AllowShortEnumsOnASingleLine: false
# Every if / else / for / while body gets braces, even a single statement.
InsertBraces: true
SpaceAfterTemplateKeyword: false
SpacesBeforeTrailingComments: 1
BinPackParameters: false
BinPackArguments: false
# Include order matters here (some headers rely on what was included before them).
SortIncludes: false
# Leave comments alone: they hold long formulas and commented-out code.
ReflowComments: false
